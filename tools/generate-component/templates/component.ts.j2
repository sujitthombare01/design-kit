    const classes = [
      '{{ spec.base_css_class }}',
{%- if spec.variants %}
      `{{ spec.base_css_class }}--${this.variant()}`,
{%- endif %}
{%- if spec.sizes %}
      `{{ spec.base_css_class }}--${this.size()}`,
{%- endif %}
    ];
{%- if spec.kind == 'static' %}
    if (this.disabled()) {
