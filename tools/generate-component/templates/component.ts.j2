import { ChangeDetectionStrategy, Component, computed, input{% if spec.output %}, output{% endif %} } from '@angular/core';
{% if spec.sizes or spec.variants %}
import type {
{%- if spec.sizes %}
  {{ spec.class_name }}Size,
{%- endif %}
{%- if spec.variants %}
  {{ spec.class_name }}Variant,
{%- endif %}
} from './{{ spec.name }}.types';
{% endif %}
@Component({
  selector: '{{ spec.selector }}',
  changeDetection: ChangeDetectionStrategy.OnPush,
  templateUrl: './{{ spec.name }}.component.html',
  styleUrl: './{{ spec.name }}.component.css',
})
export class {{ spec.full_class }} {
{%- if spec.for_attribute %}
  readonly for = input.required<string>();
{%- endif %}
{%- if spec.variants %}
