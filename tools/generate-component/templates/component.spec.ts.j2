    });
{% endfor %}
  });
{% if spec.output %}
  describe('events', () => {
    it('emits {{ spec.output.camel }} on a native click', () => {
      const { component, host } = createFixture();
      let emitted: {{ spec.output.payload }} | undefined;
      component.{{ spec.output.camel }}.subscribe((event: {{ spec.output.payload }}) => {
        emitted = event;
      });
      host.click();
      expect(emitted).toBeInstanceOf(MouseEvent);
    });

    it('does not emit {{ spec.output.camel }} when disabled', () => {
      const { component, fixture } = createFixture();
      fixture.componentRef.setInput('disabled', true);
      fixture.detectChanges();
      let emitted = false;
      component.{{ spec.output.camel }}.subscribe(() => {
        emitted = true;
      });
      // Bypass native click gating (relevant for a <button> host) to assert
      // the component's own interactive guard, not just DOM-level gating.
      fixture.debugElement
        .query(By.css('{{ spec.element }}'))
        .triggerEventHandler('click', new MouseEvent('click'));
      expect(emitted).toBe(false);
    });
  });
{% endif %}
{% if spec.element == 'button' %}
  describe('accessibility', () => {
    it('is reachable via Tab and activates through native button semantics', () => {
      const { host } = createFixture();
      const button = host as HTMLButtonElement;
      button.focus();
      expect(document.activeElement).toBe(button);
    });
  });
{% endif %}
  describe('OnPush change detection', () => {
    it('updates the view when a signal input changes, without manual double detectChanges', () => {
      const { host, fixture } = createFixture();
      fixture.componentRef.setInput('disabled', true);
      fixture.detectChanges();
{%- if spec.element == 'button' %}
      expect((host as HTMLButtonElement).disabled).toBe(true);
{%- else %}
      expect(host.getAttribute('aria-disabled')).toBe('true');
{%- endif %}
    });
  });
});
