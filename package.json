{
  "name": "design-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "type-check": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint . && stylelint \"projects/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"projects/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test atom",
    "test:watch": "ng test atom --watch",
    "test:coverage": "ng test atom --coverage",
    "build": "ng build atom && ng build ux && node scripts/patch-ux-exports.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "generate:component": "python3 tools/generate-component/generate.py",
    "remove:component": "python3 tools/generate-component/generate.py --remove"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^3.0.0-alpha.64",
    "@angular/animations": "^21.2.19",
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-themes": "^10.5.6",
    "@storybook/angular": "^10.5.6",
    "@storybook/builder-vite": "^10.5.6",
    "@storybook/test-runner": "^0.24.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-storybook": "^10.5.6",
    "globals": "^17.9.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "storybook": "^10.5.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "zone.js": "^0.16.2"
  }
}
